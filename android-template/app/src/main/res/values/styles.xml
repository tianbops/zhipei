<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- 系统状态栏背景从主题首帧起透明；图标默认按浅色页面使用深色图标。 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- 启动屏退出后的窗口底色同样钉成主题承接色，避免任何时刻露出继承的近白底板
             （状态栏区透明，露出的正是这块 windowBackground / DecorView 背景）。 -->
        <item name="android:windowBackground">@color/splashBackground</item>
    </style>

    <!-- 启动主题（2026-10-30，v1.0.22）
         改用 androidx core-splashscreen 的 Theme.SplashScreen：启动屏的生命周期不再由
         「窗口画出第一帧」决定，而由 MainActivity 的 setKeepOnScreenCondition 决定，
         一直保持到网页首帧就绪（桥方法 webReady）。远程首屏要 1.5 到 2 秒才画得出内容，
         旧做法在这段时间会露出空白窗口，正是用户录屏里那段空窗。
         背景固定为品牌黑 #05070A，logo 自带黑底与启动屏背景无缝融合，不随系统外观切换。
         postSplashScreenTheme 是启动屏退出后切回的主题，必须是 AppCompat 系。 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashBackground</item>
        <!-- 起始窗口底色必须显式钉死：不声明就继承父级（Theme.SplashScreen / AppCompat.Light）
             的近白 windowBackground，冷启动会在黑色启动屏之前先露一帧纯白 —— 深浅外观都
             躲不过，因为本壳的原生宿主主题刻意不随系统 DayNight 切换（见 MainActivity）。
             取与启动屏同一个 @color/splashBackground，交接处零色差。 -->
        <item name="android:windowBackground">@color/splashBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_badge</item>
        <item name="windowSplashScreenAnimationDuration">240</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>
