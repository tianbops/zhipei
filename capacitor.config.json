{
  "appId": "com.tianbops.zhipei",
  "appName": "智配One",
  "webDir": "www",
  "loggingEnabled": false,
  "server": {
    "url": "https://tianyou-zhipei.pages.dev/",
    "androidScheme": "https",
    "cleartext": false,
    "errorPath": "offline.html"
  },
  "android": {
    "webContentsDebuggingEnabled": false,
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#05070A",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
